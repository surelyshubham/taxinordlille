# =============================================================================
# Taxi Nord Lille — environment configuration
#
# Copy this file to `.env.local` for local development:
#     cp .env.example .env.local
#
# NEVER commit `.env.local`. On Vercel, add these as Project Settings →
# Environment Variables. Mark everything secret as "Sensitive".
# =============================================================================


# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL) — REQUIRED
# -----------------------------------------------------------------------------
# Neon Console → your project → Connection Details → pooled connection string.
# Use the POOLED connection string for the running app and the direct one for
# migrations (`db:migrate`), because the pooled one goes through a proxy that
# does not support prepared statements.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string, used only by `npm run db:migrate`.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"


# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# The public origin, without a trailing slash. Used for canonical URLs, the
# sitemap, hreflang alternates and the links inside notification emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Administrator seeding — used by `npm run seed:admin`
# -----------------------------------------------------------------------------
# There is no public registration. The only administrator is created here.
# Read these at seed time; they can be unset afterwards if you prefer.
ADMIN_EMAIL="owner@taxinordlille.fr"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Exploitant"


# -----------------------------------------------------------------------------
# Transactional email (Resend) — OPTIONAL
# -----------------------------------------------------------------------------
# Without these, quote requests are still stored and the site works normally.
# The admin panel will report the notification as "Non configuré" and the
# operator can still call or WhatsApp each customer.
#
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# Optional explicit sender. Must be a domain you have verified in Resend.
# Falls back to notifications.emailTo when empty.
# RESEND_FROM_EMAIL="site@votredomaine.fr"


# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta) — OPTIONAL
# -----------------------------------------------------------------------------
# All four values are required for automated alerts to be sent. If any is
# missing, the enquiry is still saved and the manual WhatsApp link is used.
#
# Meta Developers → your app → WhatsApp → API Setup
# WHATSAPP_ACCESS_TOKEN="EAAG..."
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# The operator's own number, digits only, international format, no "+".
# WHATSAPP_BUSINESS_RECIPIENT="33612345678"


# -----------------------------------------------------------------------------
# Image storage for blog covers — OPTIONAL (one provider is enough)
# -----------------------------------------------------------------------------
# With neither configured, the CMS still works: you can paste an external
# image URL instead of uploading.
#
# --- Option A: Cloudinary (signed, server-side upload) ---
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="your-api-secret"
#
# --- Option B: Vercel Blob ---
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."


# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Optional: a stable 32-byte base64 secret shared by every instance, required
# when running more than one server behind a load balancer so Server Action
# payloads stay decryptable across instances.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""


# -----------------------------------------------------------------------------
# Data retention (GDPR)
# -----------------------------------------------------------------------------
# How long enquiries are kept before being purged. The value is also editable
# from Admin → Paramètres; this variable is only the seed default.
# DATA_RETENTION_MONTHS="24"